# Generated / local extract output (batch dumps, summaries)
/out/
out/
*.log

# Session payloads — may contain prompts, paths, tool args (never publish)
**/updates.jsonl
**/chat_history.jsonl
**/events.jsonl
**/signals.json
# Loose extract artifacts if written outside out/
*-events.jsonl
*-summary.json

# Local maintainer regression scripts (not part of the public tree)
/test/*
!/test/test_model_rates.py
!/test/test_subagent_peel.py
!/test/test_system_window.py
!/test/test_aggregate.py
!/test/test_cache_reconstruct.py
!/test/test_cache_miss_call1.py
!/test/test_finalize_anchor.py
!/test/test_history_watch.py
!/test/test_period_attr.py

# Maintainer session notes (not required for install)
.grok/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Secrets / local overrides (never commit)
.env
.env.*
*.local.json
